# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow the env template
!.env.example

# real data from the old Lovable app (PDPA) - never commit
lovable-data/
lovable-source/

# 2FA recovery codes / backup codes - never commit
*recovery-codes*
*backup-codes*

# local database backups (real employee data) - never commit
backups/

# slides/reports made for the user - keep out of git
exports/
