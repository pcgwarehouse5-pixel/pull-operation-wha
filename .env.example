# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ไฟล์ .env.local ไม่ขึ้น GitHub)
# ค่าทั้งหมดดูได้ที่ Supabase > Project Settings

# Supabase > Project Settings > API (ใส่ใน Vercel ด้วย)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ลับ: ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น (ใส่ใน Vercel ด้วย ห้ามขึ้นต้นด้วย NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# รหัสผ่านเริ่มต้นของบัญชีที่ย้ายมา/สร้างใหม่/รีเซ็ต (ผู้ใช้ต้องเปลี่ยนตอนเข้าครั้งแรก) ใส่ใน Vercel ด้วย
DEFAULT_USER_PASSWORD=

# ใช้ในเครื่องเท่านั้น (npm run db:setup) ไม่ต้องใส่ใน Vercel
# Supabase > Connect > Session pooler (แทน [YOUR-PASSWORD] ด้วยรหัสผ่านฐานข้อมูล)
SUPABASE_DB_URL=

# โดเมนภายในสำหรับแปลงรหัสพนักงานเป็นอีเมลล็อกอิน (ไม่มีการส่งอีเมลจริง)
NEXT_PUBLIC_LOGIN_DOMAIN=wha.local
